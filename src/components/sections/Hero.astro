---
import Icon from '../Icon.astro';
---

<section id="slide-0" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-50 z-0" />

  <div class="relative z-10 w-full max-w-5xl mx-4 border border-white/20 bg-dark-bg/80 backdrop-blur-sm hero-enter">
    <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-cyan-500" style="animation: cornerFade 0.6s 0.2s ease-out forwards; opacity: 0;" />
    <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-cyan-500" style="animation: cornerFade 0.6s 0.3s ease-out forwards; opacity: 0;" />
    <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-cyan-500" style="animation: cornerFade 0.6s 0.4s ease-out forwards; opacity: 0;" />
    <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-cyan-500" style="animation: cornerFade 0.6s 0.5s ease-out forwards; opacity: 0;" />

    <div class="p-8 md:p-16 overflow-hidden">
      <div class="flex justify-between items-center mb-12 border-b border-white/10 pb-4" style="animation: heroFadeIn 0.6s 0.3s ease-out forwards; opacity: 0;">
        <div class="flex gap-2">
          <span class="w-2 h-2 bg-cyan-500 animate-pulse" />
          <span class="text-xs font-mono text-cyan-500 tracking-widest">[ SYS.ONLINE ]</span>
        </div>
        <span class="text-xs font-mono text-white/40 uppercase tracking-widest">ID: h4nzs // SECURE_CONN</span>
      </div>

      <div class="flex flex-col items-start space-y-8">
        <div style="animation: heroFadeIn 0.8s 0.5s ease-out forwards; opacity: 0;">
          <h1 class="text-6xl md:text-8xl font-bold tracking-tight text-white mb-4 uppercase font-mono glitch-text" data-text="DEHAN">
            DEHAN
          </h1>
          <div class="flex items-center gap-4 mt-6">
            <Icon name="Terminal" size={24} class="text-cyan-400" />
            <p class="font-mono text-sm md:text-lg text-cyan-400 uppercase tracking-[0.2em]">
              Fullstack Architect
            </p>
          </div>
        </div>

        <div class="max-w-2xl text-lg md:text-xl text-white/70 leading-relaxed font-mono border-l-2 border-cyan-500/50 pl-6 py-2" style="animation: heroFadeIn 0.8s 0.7s ease-out forwards; opacity: 0;">
          Engineering <span class="text-white font-bold bg-white/10 px-1">secure</span> digital ecosystems
          with precision and zero-trust architecture. Building systems that refuse to break.
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mt-8 w-full sm:w-auto" style="animation: heroFadeIn 0.8s 0.9s ease-out forwards; opacity: 0;">
          <a
            href="#slide-1"
            class="group relative px-8 py-4 bg-cyan-500 text-black font-mono font-bold uppercase tracking-widest overflow-hidden"
          >
            <span class="relative z-10">INIT: Explore Work</span>
            <div class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out" />
          </a>

          <a
            href="https://github.com/h4nzs"
            target="_blank"
            rel="noreferrer"
            class="px-8 py-4 border border-white/20 text-white font-mono font-bold uppercase tracking-widest hover:bg-white/10 transition-colors flex items-center justify-center gap-3"
          >
            <Icon name="Cpu" size={18} />
            [ GITHUB ]
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero-enter {
    animation: heroFadeIn 0.8s ease-out forwards;
  }

  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes cornerFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
