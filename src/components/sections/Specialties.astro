---
import { slideById } from '../../data/portfolioData';
import Icon from '../Icon.astro';
const data = slideById(2);
---

<section id="slide-2" class="pt-24">
  <h2 data-enter="left" class="text-4xl font-bold mb-12">Specialties.</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
    {data.specialties.map((s, i) => (
      <div data-enter="up" data-spotlight class="p-8 border-t-2 border-cyan-500/50 overflow-hidden border border-white/20 bg-dark-bg transition-all duration-300 hover:border-cyan-500/50 hover:shadow-[0_0_15px_rgba(34,211,238,0.1)]" style={`transition-delay: ${i * 0.12}s`}>
        <Icon name={s.icon} size={32} class="text-cyan-400 mb-6" />
        <h3 class="text-2xl font-bold mb-4">{s.title}</h3>
        <p class="text-white/60 leading-relaxed">{s.desc}</p>
      </div>
    ))}
  </div>
</section>
