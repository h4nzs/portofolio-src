---
import Icon from '../Icon.astro';
---

<section id="slide-10" class="pt-24 pb-24 text-center">
  <h2 data-enter="up" class="text-6xl font-bold mb-8 uppercase tracking-tighter">Ready to Initiate?</h2>
  <p data-enter="focus" class="text-xl text-white/50 mb-12 font-mono uppercase tracking-widest">// Let's build secure, scalable systems together.</p>
  <div class="flex justify-center flex-wrap gap-6">
    <a
      href="#"
      data-email="moc.liamg@431nahedayas"
      data-enter="left"
      class="px-8 py-4 bg-cyan-500 text-black font-mono font-bold uppercase tracking-widest hover:bg-cyan-400 transition-colors flex items-center gap-3"
      aria-label="Send Email"
    >
      <Icon name="Mail" size={20} /> [ SEND_COMMS ]
    </a>
    <a href="https://github.com/h4nzs" target="_blank" rel="noreferrer" aria-label="GitHub" data-enter="up" class="px-6 py-4 bg-dark-bg border border-white/20 hover:border-cyan-500 text-white hover:text-cyan-400 transition-colors flex items-center gap-3 font-mono uppercase">
      <Icon name="Github" size={20} />
    </a>
    <a href="https://instagram.com/h4nzss" target="_blank" rel="noreferrer" aria-label="Instagram" data-enter="up" class="px-6 py-4 bg-dark-bg border border-white/20 hover:border-cyan-500 text-white hover:text-cyan-400 transition-colors flex items-center gap-3 font-mono uppercase" style="transition-delay: 0.1s">
      <Icon name="Instagram" size={20} />
    </a>
    <a href="https://linkedin.com/in/muhammad-dehan-amada" target="_blank" rel="noreferrer" aria-label="LinkedIn" data-enter="right" class="px-6 py-4 bg-dark-bg border border-white/20 hover:border-cyan-500 text-white hover:text-cyan-400 transition-colors flex items-center gap-3 font-mono uppercase">
      <Icon name="Linkedin" size={20} />
    </a>
  </div>
</section>

<script>
  document.querySelectorAll('[data-email]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const email = el.getAttribute('data-email').split('').reverse().join('');
      window.location.href = `mailto:${email}`;
    });
  });
</script>
