---
import { slideById } from '../../data/portfolioData';
import SpotlightCard from '../react/SpotlightCard';
const data = slideById(1);
---

<section id="slide-1" class="relative pt-24 min-h-[800px] flex items-center overflow-hidden">
  <div class="absolute right-0 top-0 bottom-0 w-full md:w-[60%] z-0 opacity-80 mix-blend-luminosity hover:mix-blend-normal transition-all duration-700">
    <img
      src={data.photo}
      alt="Dehan Amada portrait"
      loading="lazy" decoding="async"
      class="w-full h-full object-cover object-center md:object-right-top"
      style={{
        maskImage: 'radial-gradient(circle at 85% 40%, black 50%, transparent 100%)',
        WebkitMaskImage: 'radial-gradient(circle at 85% 40%, black 50%, transparent 100%)',
      }}
    />
    <div class="absolute inset-0 bg-gradient-to-l from-transparent via-dark-bg/20 to-dark-bg" />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-transparent to-transparent" />
  </div>

  <div class="relative z-10 max-w-3xl space-y-8">
    <h2 data-enter="left" class="text-5xl md:text-7xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-white to-white/50">
      About Me.
    </h2>
    <div
      data-enter="focus"
      class="text-lg md:text-xl text-white/80 leading-relaxed font-light backdrop-blur-sm p-8 border-l-4 border-cyan-500 bg-black/40"
      set:html={data.html}
    />
    <div class="flex flex-wrap gap-3">
      {data.hobbies.map((h, i) => (
        <SpotlightCard client:load>
          <div data-enter="up" class="px-4 py-2 text-xs font-mono text-cyan-400 uppercase tracking-wider" style={`transition-delay: ${i * 0.1}s`}>
            {h}
          </div>
        </SpotlightCard>
      ))}
    </div>
  </div>
</section>
