---
import { slideById } from '../../data/portfolioData';
const data = slideById(5);
---

<section id="slide-5" class="pt-24">
  <h2 data-enter="left" class="text-4xl font-bold mb-12">Education.</h2>
  <div class="space-y-0">
    {data.history.map((edu, i) => (
      <div
        data-enter="focus"
        data-spotlight
        class="group pl-8 pb-12 border-l-2 border-white/10 hover:border-cyan-500/50 transition-colors"
        style={`transition-delay: ${i * 0.1}s`}
      >
        <div class="absolute left-0 top-0 w-3 h-3 -translate-x-[7px] rounded-full bg-cyan-500 border-2 border-dark-bg" />
        <div class="p-6 border border-white/10 bg-dark-bg/80 hover:border-cyan-500/30 transition-colors">
          <span class="text-xs font-mono text-cyan-500 uppercase tracking-wider">{edu.period}</span>
          <h3 class="text-xl font-bold mt-1">{edu.title}</h3>
          <p class="text-cyan-400/80 text-sm font-mono">{edu.role}</p>
          <p class="text-white/50 text-sm mt-2">{edu.details}</p>
        </div>
      </div>
    ))}
  </div>
</section>
