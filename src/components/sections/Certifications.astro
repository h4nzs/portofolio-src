---
import { slideById } from '../../data/portfolioData';
const data = slideById(6);
---

<section id="slide-6" class="relative pt-24 min-h-[600px] flex flex-col justify-center overflow-hidden">
  <div class="absolute right-0 top-0 bottom-0 w-full md:w-[60%] z-0 opacity-50 mix-blend-luminosity hover:mix-blend-normal transition-all duration-700 pointer-events-none">
    <img
      src="/portofolio/images/profile-2.webp"
      alt="Dehan Amada secondary portrait"
      loading="lazy" decoding="async"
      class="w-full h-full object-cover object-[50%_45%]"
      style={{
        maskImage: 'radial-gradient(circle at 85% 40%, black 50%, transparent 100%)',
        WebkitMaskImage: 'radial-gradient(circle at 85% 40%, black 50%, transparent 100%)',
      }}
    />
    <div class="absolute inset-0 bg-gradient-to-l from-transparent via-dark-bg/20 to-dark-bg" />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-transparent to-transparent" />
  </div>

  <div class="relative z-10 w-full">
    <h2 data-enter="left" class="text-4xl font-bold mb-12">Certifications.</h2>
    <div class="flex gap-6 overflow-x-auto pb-4">
      {data.certs.map((c, i) => (
        <div data-enter="up" data-spotlight class="min-w-[300px] p-4 group cursor-pointer border border-white/10 hover:border-cyan-500 transition-colors bg-dark-bg" style={`transition-delay: ${i * 0.15}s`}>
          <div
            class="h-40 bg-black/50 mb-4 overflow-hidden relative"
            onclick={`document.getElementById('cert-img').src='${c.img}'; document.getElementById('cert-modal').classList.remove('hidden')`}
          >
            <img src={c.img} alt={c.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform opacity-60 group-hover:opacity-100" />
            <div class="absolute inset-0 bg-cyan-500/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
          </div>
          <h3 class="font-bold text-lg uppercase font-mono tracking-tight">{c.title}</h3>
          <p class="text-xs text-white/50 font-mono">[{c.desc}]</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', (e) => {
    const modal = document.getElementById('cert-modal');
    if (e.target === modal || e.target.closest('#cert-modal .close-btn')) {
      modal?.classList.add('hidden');
    }
  });
</script>
