---
import { slideById } from '../../data/portfolioData';
const data = slideById(4);
---

<section id="slide-4" class="pt-24">
  <h2 data-enter="right" class="text-4xl font-bold mb-12 text-right">Core Competencies.</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {data.skills.soft.map((s, i) => (
      <div data-enter="tilt" data-spotlight class="p-6 border-t-2 border-cyan-500/50 overflow-hidden border border-white/20 bg-dark-bg transition-all duration-300 hover:border-cyan-500/50" style={`transition-delay: ${i * 0.12}s`}>
        <h3 class="text-xl font-bold mb-2">{s.label}</h3>
        <p class="text-sm text-white/60">{s.value}</p>
      </div>
    ))}
  </div>
</section>
