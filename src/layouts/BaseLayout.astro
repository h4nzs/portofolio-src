---
import '../styles/global.css';
import '../styles/glitch.css';

const site = 'https://h4nzs.github.io/portofolio/';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dehan Amada',
  url: site,
  sameAs: [
    'https://github.com/h4nzs',
    'https://www.linkedin.com/in/muhammad-dehan-amada',
    'https://twitter.com/h4nzs',
    'https://instagram.com/h4nzss',
  ],
  jobTitle: 'Web Developer',
  knowsAbout: ['Web Development', 'DevOps', 'Cybersecurity', 'Applied Cryptography', 'Post-Quantum Cryptography', 'AI Agents', 'Rust', 'Go', 'TypeScript', 'Network Engineering'],
  description: 'Dehan Amada is a fullstack engineer from Bandung, Indonesia, working on web development, DevOps, security and AI agents.',
  image: `${site}images/profile-2.webp`,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'STMIK AMIK Bandung' },
    { '@type': 'EducationalOrganization', name: 'SMKN 4 Padalarang' },
  ],
  worksFor: { '@type': 'Organization', name: 'PT Ono Voda Pro' },
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    ['What is Dehan Amada\'s expertise?', 'Fullstack development with a focus on security: applied cryptography, DevOps and infrastructure hardening, and AI agents built on LLMs.'],
    ['What projects has Dehan Amada built?', 'Key projects include Nyx Chat (a post-quantum, zero-knowledge messenger), the Ahli Panggilan service platform with an A2A AI agent, Pixcode Studio, and the mirAI movie advisor.'],
    ['Is Dehan Amada available for hire?', 'Dehan works at PT Ono Voda Pro and is open to collaboration on secure systems and fullstack projects. Contact him via email, LinkedIn or Instagram.'],
  ].map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};
---

